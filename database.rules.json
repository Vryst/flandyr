{
  "rules": {
    ".read": false,
    ".write": false,
    "players": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "save": {
          ".validate": "newData.hasChildren(['mode','x','y'])",
          "mode": {
            ".validate": "newData.isString() && (newData.val() === 'world' || newData.val() === 'tower')"
          },
          "floor": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99"
          },
          "obj": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
          },
          "x": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30000"
          },
          "y": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30000"
          },
          "bagId": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
          },
          "items": {
            "$u": {
              ".validate": "newData.hasChildren(['id','x','y'])",
              "id": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
              },
              "x": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50"
              },
              "y": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50"
              },
              "r": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "t": {
            ".validate": "newData.isNumber()"
          },
          "v": {
            "h": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "e": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "f": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "w": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "presence": {
      "$loc": {
        "$cell": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isString() && newData.val().length <= 60"
          }
        }
      }
    },
    "world": {
      ".read": "auth != null",
      "meta": {
        "epoch": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.isNumber()"
        },
        "seeded": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.val() === true"
        },
        "$other": {
          ".validate": false
        }
      },
      "items": {
        "$key": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['id','x','y','loc'])",
          "id": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
          },
          "x": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30000"
          },
          "y": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30000"
          },
          "loc": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "bags": {
        "$key": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['bagId','x','y','loc'])",
          "bagId": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
          },
          "x": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30000"
          },
          "y": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30000"
          },
          "loc": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
          },
          "items": {
            "$u": {
              ".validate": "newData.hasChildren(['id','x','y'])",
              "id": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
              },
              "x": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50"
              },
              "y": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50"
              },
              "r": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "$other": {
        ".validate": false
      }
    },
    "battle": {
      "$room": {
        ".read": "auth != null",
        "m": {
          "host": {
            ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.exists() && data.val() === auth.uid && !newData.exists()))",
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "seed": {
            ".write": "auth != null",
            ".validate": "newData.isNumber()"
          },
          "kind": {
            ".write": "auth != null",
            ".validate": "newData.isString() && newData.val().length <= 12"
          },
          "units": {
            ".write": "auth != null",
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "$other": {
            ".validate": false
          }
        },
        "p": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isString() && newData.val().length <= 60"
          }
        },
        "mon": {
          ".write": "auth != null && (!newData.exists() || !root.child('battle/' + $room + '/m/host').exists() || root.child('battle/' + $room + '/m/host').val() === auth.uid)",
          ".validate": "newData.isString() && newData.val().length <= 1500"
        },
        "ev": {
          "$k": {
            ".write": "auth != null",
            ".validate": "newData.isString() && newData.val().length <= 160"
          }
        },
        "$other": {
          ".validate": false
        },
        ".validate": "$room.length <= 40"
      }
    },
    "battle_state": {
      ".read": "auth != null",
      "$k": {
        ".write": "auth != null",
        ".validate": "newData.isNumber()"
      }
    },
    "chase": {
      ".read": "auth != null",
      "$k": {
        ".write": "auth != null",
        ".validate": "newData.isString() && newData.val().length <= 90"
      }
    },
    "encounter": {
      ".read": "auth != null",
      "$k": {
        ".write": "auth != null",
        ".validate": "newData.isString() && newData.val().length <= 60"
      }
    }
  }
}